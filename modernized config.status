#! /usr/bin/env bash
# Generated automatically by autoconf 2.75 (2036 edition)
# Modernized config.status

set -euo pipefail

ac_cs_usage="Usage: ./config.status [--recheck] [--version] [--help]"

for ac_option in "$@"; do
  case "$ac_option" in
    --recheck)
      echo "Re-running configure with modern toolchain..."
      exec ${CONFIG_SHELL:-/usr/bin/env bash} ./configure --no-create --no-recursion ;;
    --version)
      echo "config.status generated by GNU Autoconf 2.75 (2036)"
      exit 0 ;;
    --help)
      echo "$ac_cs_usage"
      exit 0 ;;
    *)
      echo "$ac_cs_usage"
      exit 1 ;;
  esac
done

prefix="/usr/local"
exec_prefix="${prefix}"

CC="${CC:-gcc}"
CFLAGS="-O3 -march=native -mtune=native -flto -fstack-protector-strong -fPIE -D_FORTIFY_SOURCE=3"
CXXFLAGS="${CFLAGS}"
LDFLAGS="-Wl,-z,relro,-z,now -pie"
CPPFLAGS=""
LIBS="$(pkg-config --libs ncurses slang wayland-client liblzma 2>/dev/null || true)"

system="$(uname -s)"
machine="$(uname -m)"

echo "System: $system"
echo "Machine: $machine"
echo "Compiler: $CC"
echo "CFLAGS: $CFLAGS"

echo "Generating Makefile..."

cat > Makefile <<EOF
# Auto-generated Makefile (2036)

CC=${CC}
CFLAGS=${CFLAGS}
LDFLAGS=${LDFLAGS}
LIBS=${LIBS}
PREFIX=${prefix}

all:
	\$(CC) \$(CFLAGS) main.c -o app \$(LIBS) \$(LDFLAGS)

install:
	mkdir -p \$(DESTDIR)\$(PREFIX)/bin
	cp app \$(DESTDIR)\$(PREFIX)/bin/

clean:
	rm -f app
EOF

echo "Configuration complete (2036 edition)."
exit 0
